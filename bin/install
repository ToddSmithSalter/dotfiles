#!/bin/sh

set -e  # Exit on error (but we use || true for optional steps)

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

step() { echo ""; echo -e "${BLUE}➜${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
error() { echo -e "${RED}✗${NC} $1"; exit 1; }

echo "Setting up your Mac..."

sudo -v

# Check for Oh My Zsh and install if we don't have it
touch ~/.hushlogin
step "Installing Oh My Zsh"
if [ ! -d ~/.oh-my-zsh ]; then
    curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh | sh -s -- --unattended || warn "Oh My Zsh installation failed"
fi
success "Oh My Zsh installed"

# Symlinks - link every dotfile in home/ into $HOME
step "Creating symlinks"
for file in "$DOTFILES_DIR"/home/.*; do
    name="$(basename "$file")"
    [ "$name" = "." ] || [ "$name" = ".." ] && continue
    rm -rf "$HOME/$name"
    ln -sf "$file" "$HOME/$name"
    success "Linked ~/$name"
done

rm -rf "$HOME/.mackup.cfg"
ln -sf "$DOTFILES_DIR/macos/.mackup.cfg" "$HOME/.mackup.cfg"
success "Linked ~/.mackup.cfg"

# Homebrew
step "Installing Homebrew"
if ! command -v brew &>/dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> ~/.zprofile
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi
success "Homebrew installed"

# nvm + latest Node LTS
step "Installing nvm and Node LTS"
export NVM_DIR="$HOME/.nvm"
if [ ! -s "$NVM_DIR/nvm.sh" ]; then
    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.5/install.sh | bash || warn "nvm installation failed"
fi
\. "$NVM_DIR/nvm.sh"
nvm install --lts && nvm alias default 'lts/*' || warn "Node LTS installation failed"
success "nvm and Node LTS installed"

# Update Homebrew recipes
brew update

# Install all our dependencies with bundle (See Brewfile)
step "Installing packages from Brewfile"
brew bundle --file="$DOTFILES_DIR/config/Brewfile"
success "Brewfile processed"

# Complete agent-browser setup (installed via Brewfile)
agent-browser install || warn "agent-browser setup skipped"

# Install PHP extensions with PECL
pecl install imagick 2>/dev/null || warn "imagick already installed or failed"
pecl install memcached 2>/dev/null || warn "memcached already installed or failed"
pecl install xdebug 2>/dev/null || warn "xdebug already installed or failed"
pecl install redis 2>/dev/null || warn "redis already installed or failed"

# Global Composer packages
step "Installing global Composer packages"
composer global require laravel/pint || warn "pint already installed or failed"
composer global require laravel/valet || warn "valet already installed or failed"
valet install || warn "valet already installed or failed"
success "Composer packages processed"

# Claude Code setup
echo ""
read -p "Install Claude Code? (y/n) " -n 1 -r
echo ""
if [[ $REPLY =~ ^[Yy]$ ]]; then
    bash "$DOTFILES_DIR/bin/install-claude-code" || warn "Claude Code setup had issues"
else
    warn "Skipping Claude Code installation"
fi

# Done
echo ""
success "Installation complete!"
echo ""
step "Next steps:"
echo "  • Set up macOS defaults: ./macos/set-defaults.sh"
echo "  • Restore settings: mackup restore (if you have backups)"
echo "  • Customize aliases: ~/.dotfiles-custom/shell/.aliases"
echo ""
echo "Optional:"
echo "  • Discover more agent skills: https://skills.sh"
echo ""
